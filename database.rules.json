{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('meta/host').val() === auth.uid || (!data.exists() && newData.child('meta/host').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".validate": "newData.child('host').val() === auth.uid && (newData.child('mode').val() === 'online' || newData.child('mode').val() === 'local')"
        },
        "players": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('meta').exists()",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            }
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "votes": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
          }
        },
        "judges": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
          }
        },
        "history": {
          "$round": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
          }
        },
        "used": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        }
      }
    }
  }
}
